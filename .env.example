# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real tokens.

# HuggingFace model ID to load the checkpoint from HF Hub.
# If set, takes priority over the local checkpoint/ directory.
# Example: HF_MODEL_ID=Rushikesh-S-Ware/NLP-SQL-Transformer
HF_MODEL_ID=

# (Optional) HuggingFace token — only needed if your model repo is private.
HF_TOKEN=
